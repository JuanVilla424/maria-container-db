# ==============================================
# MariaDB Configuration for ECS/Docker
# ==============================================

# Docker Build Configuration (required for mariadb base image)
DOCKER_BUILDKIT=0
COMPOSE_DOCKER_CLI_BUILD=0

# Basic MariaDB Configuration
STACK_VERSION=11.4
MARIADB_PORT=3306
MARIADB_DATABASE=appdb
MARIADB_ROOT_PASSWORD="<18 (Chars-with-specials)>"
MARIADB_USER=appuser
MARIADB_PASSWORD="<18 (Chars-with-specials)>"

# Database Configuration
DATABASE_NAME=appdb

# Network Configuration
MARIADB_BIND_ADDRESS=0.0.0.0
MARIADB_MAX_CONNECTIONS=500
MARIADB_CONNECT_TIMEOUT=10
MARIADB_WAIT_TIMEOUT=28800
MARIADB_INTERACTIVE_TIMEOUT=28800

# Storage Engine Configuration (InnoDB)
MARIADB_INNODB_BUFFER_POOL_SIZE=1G
MARIADB_INNODB_LOG_FILE_SIZE=256M
MARIADB_INNODB_LOG_BUFFER_SIZE=64M
MARIADB_INNODB_FLUSH_LOG_AT_TRX_COMMIT=1
MARIADB_INNODB_FLUSH_METHOD=O_DIRECT
MARIADB_INNODB_FILE_PER_TABLE=ON
MARIADB_INNODB_OPEN_FILES=4000
MARIADB_INNODB_IO_CAPACITY=2000
MARIADB_INNODB_IO_CAPACITY_MAX=4000

# Query Cache Configuration
MARIADB_QUERY_CACHE_TYPE=0
MARIADB_QUERY_CACHE_SIZE=0

# Thread Configuration
MARIADB_THREAD_CACHE_SIZE=128
MARIADB_THREAD_STACK=256K

# Table Configuration
MARIADB_TABLE_OPEN_CACHE=4000
MARIADB_TABLE_DEFINITION_CACHE=2000
MARIADB_OPEN_FILES_LIMIT=65535

# Binary Logging (Replication)
MARIADB_LOG_BIN=mysql-bin
MARIADB_BINLOG_FORMAT=ROW
MARIADB_EXPIRE_LOGS_DAYS=7
MARIADB_MAX_BINLOG_SIZE=512M
MARIADB_SYNC_BINLOG=1
MARIADB_SERVER_ID=1

# Slow Query Log
MARIADB_SLOW_QUERY_LOG=ON
MARIADB_SLOW_QUERY_LOG_FILE=/var/log/mysql/slow.log
MARIADB_LONG_QUERY_TIME=2
MARIADB_LOG_QUERIES_NOT_USING_INDEXES=OFF

# General Log (Disable in production)
MARIADB_GENERAL_LOG=OFF
MARIADB_GENERAL_LOG_FILE=/var/log/mysql/general.log

# Error Log
MARIADB_LOG_ERROR=/var/log/mysql/error.log
MARIADB_LOG_WARNINGS=2
LOG_LEVEL=INFO

# Security Configuration
MARIADB_SECURE_AUTH=ON
MARIADB_LOCAL_INFILE=OFF
MARIADB_SKIP_NAME_RESOLVE=ON
MARIADB_SYMBOLIC_LINKS=OFF

# SSL Configuration
MARIADB_SSL=false
MARIADB_SSL_CA=/etc/mysql/ssl/ca.pem
MARIADB_SSL_CERT=/etc/mysql/ssl/server-cert.pem
MARIADB_SSL_KEY=/etc/mysql/ssl/server-key.pem

# Character Set Configuration
MARIADB_CHARACTER_SET_SERVER=utf8mb4
MARIADB_COLLATION_SERVER=utf8mb4_unicode_ci

# Memory Configuration
MARIADB_KEY_BUFFER_SIZE=256M
MARIADB_SORT_BUFFER_SIZE=4M
MARIADB_READ_BUFFER_SIZE=2M
MARIADB_READ_RND_BUFFER_SIZE=8M
MARIADB_JOIN_BUFFER_SIZE=4M
MARIADB_TMP_TABLE_SIZE=64M
MARIADB_MAX_HEAP_TABLE_SIZE=64M

# Packet Configuration
MARIADB_MAX_ALLOWED_PACKET=256M

# Container Resource Configuration
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=4G
CONTAINER_SWAP_LIMIT=1G
CONTAINER_PIDS_LIMIT=4096

# Volume Paths
MARIADB_DATA_PATH=/var/lib/mysql
MARIADB_LOGS_PATH=/var/log/mysql
MARIADB_CONFIG_PATH=/etc/mysql
MARIADB_BACKUP_PATH=/backup

# Resource Limits
MARIADB_ULIMIT_NOFILE=65535
MARIADB_ULIMIT_NPROC=65535

# Locale Configuration
LANG=es_CO.UTF-8
LC_ALL=es_CO.UTF-8

# Initialization
MARIADB_INIT_TIMEOUT=60
MARIADB_BOOTSTRAP_TIMEOUT=300

# ==============================================
# MariaDB 11+ Specific Configurations
# ==============================================

# Performance Schema
MARIADB_PERFORMANCE_SCHEMA=ON

# InnoDB Advanced (11+)
MARIADB_INNODB_BUFFER_POOL_INSTANCES=8
MARIADB_INNODB_READ_IO_THREADS=8
MARIADB_INNODB_WRITE_IO_THREADS=8
MARIADB_INNODB_PURGE_THREADS=4
MARIADB_INNODB_ADAPTIVE_HASH_INDEX=ON
MARIADB_INNODB_CHANGE_BUFFERING=all
MARIADB_INNODB_DOUBLEWRITE=ON
MARIADB_INNODB_STATS_ON_METADATA=OFF

# Galera Cluster Configuration (Optional)
MARIADB_GALERA_CLUSTER=false
MARIADB_WSREP_CLUSTER_NAME=galera_cluster
MARIADB_WSREP_CLUSTER_ADDRESS=gcomm://
MARIADB_WSREP_NODE_NAME=node1
MARIADB_WSREP_NODE_ADDRESS=
MARIADB_WSREP_SST_METHOD=mariabackup
MARIADB_WSREP_SST_AUTH=

# Optimizer Configuration (11+)
MARIADB_OPTIMIZER_SWITCH="index_merge=on,index_merge_union=on,index_merge_sort_union=on,index_merge_intersection=on"

# Health Check Configuration
MARIADB_HEALTH_CHECK_INTERVAL=30s
MARIADB_HEALTH_CHECK_TIMEOUT=10s
MARIADB_HEALTH_CHECK_RETRIES=3
MARIADB_HEALTH_CHECK_START_PERIOD=60s

# Process Management
MARIADB_PID_FILE=/var/run/mysqld/mysqld.pid
MARIADB_SOCKET=/var/run/mysqld/mysqld.sock

# AWS Secrets Manager (Optional - for production)
USE_SECRETS_MANAGER=false
MARIADB_SECRET_NAME=ecs/mariadb/credentials
AWS_REGION=us-east-1

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Settings
BACKUP_ENABLED=true
BACKUP_DIRECTORY=/backup
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_COMPRESSION=true
BACKUP_COMPRESSION_ALGORITHM=zstd
BACKUP_PARALLEL_THREADS=4

# Point-in-Time Recovery Configuration
PITR_ENABLED=false
PITR_BINLOG_RETENTION_HOURS=72

# Storage Configuration
BACKUP_STORAGE_TYPE=local
BACKUP_MAX_SIZE_GB=100
BACKUP_ARCHIVE_ENABLED=true
BACKUP_ARCHIVE_AFTER_DAYS=30

# AWS S3 Configuration (for backup storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PREFIX=mariadb-backups/

# Security Configuration (backup-specific)
BACKUP_ENCRYPTION_ENABLED=false
BACKUP_ENCRYPTION_KEY=
ENABLE_AUDIT_LOGGING=true

# Performance Configuration (backup-specific)
BACKUP_CHECKPOINT_INTERVAL=1000
BACKUP_MEMORY_LIMIT_MB=1024
BACKUP_IO_CONCURRENCY=2

# Logging Configuration (backup-specific)
LOG_FILE_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Timeout Configuration (backup-specific)
MARIADB_CONNECTION_TIMEOUT=30
BACKUP_OPERATION_TIMEOUT=3600
RESTORE_OPERATION_TIMEOUT=7200

# Notification Configuration
NOTIFICATIONS_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_EMAIL=

# Health Check Configuration (backup-specific)
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=300

# Git Integration for Custom Scripts
GIT_REPO=
GIT_BRANCH=main
GIT_USERNAME=
GIT_TOKEN=
SCRIPTS_PATH=database/scripts
